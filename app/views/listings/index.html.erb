<div class="container py-5">
  <h1 class="mb-4">Listings</h1>

  <% if @rooms.empty? %>
    <p class="text-muted">No listings match your search.</p>
  <% else %>
    <div class="row g-4">
      <% @rooms.each do |room| %>
        <div class="col-md-4">
          <%= render "listing_card", room: room %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
