<div class="container py-5">
  <h1 class="mb-4">Properties</h1>
  <div class="row g-4">
    <% @properties.each do |property| %>
      <div class="col-md-4">
        <div class="card p-3 h-100">
          <h2 class="h5"><%= property.neighborhood.name %></h2>
          <p class="text-muted mb-1"><%= property.address %></p>
          <p><%= pluralize(property.rooms.count, "room") %></p>
          <%= link_to "View property", property_path(property), class: "link-brand" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
