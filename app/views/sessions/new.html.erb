<div class="container py-5" style="max-width: 34rem">
  <h1 class="mb-4">Sign in</h1>
  <%= form_with url: session_path, class: "card card-body shadow-sm" do |form| %>
    <div class="mb-3">
      <%= form.label :email, class: "form-label" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
                           value: params[:email], class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
                              maxlength: 72, class: "form-control" %>
    </div>
    <%= form.submit "Sign in", class: "btn btn-primary" %>
  <% end %>
  <p class="mt-3"><%= link_to "Forgot password?", new_password_path %> · <%= link_to "Create an account", new_registration_path %></p>
</div>
