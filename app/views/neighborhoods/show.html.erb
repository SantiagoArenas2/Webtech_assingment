<div class="container py-5">
  <h1 class="mb-4"><%= @neighborhood.name %></h1>

  <% if @rooms.empty? %>
    <p class="text-muted">No published rooms in this neighborhood right now.</p>
  <% else %>
    <div class="row g-4">
      <% @rooms.each do |room| %>
        <div class="col-md-4">
          <%= render "listings/listing_card", room: room %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
