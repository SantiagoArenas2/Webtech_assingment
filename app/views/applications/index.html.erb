<div class="container py-5">
  <h1 class="mb-4">Applications</h1>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Seeker</th>
        <th>Room</th>
        <th>Status</th>
        <th>Submitted</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @applications.each do |application| %>
        <tr>
          <td><%= application.seeker.name %></td>
          <td><%= link_to application.room.label, listing_path(application.room) %></td>
          <td><span class="badge bg-secondary"><%= application.status.humanize %></span></td>
          <td><%= application.created_at.strftime("%b %-d, %Y") %></td>
          <td><%= link_to "View", application_path(application), class: "link-brand" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
