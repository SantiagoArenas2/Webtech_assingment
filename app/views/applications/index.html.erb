<div class="container py-5">
  <h1 class="mb-4">Applications <small class="text-muted fs-5">(<span id="pending_count"><%= @pending_count %></span> pending)</small></h1>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Seeker</th>
        <th>Room</th>
        <th>Status</th>
        <th>Submitted</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="applications_rows">
      <% @applications.each do |application| %>
        <%= render "application_row", application: application %>
      <% end %>
    </tbody>
  </table>
</div>
