Table users {
  id            int       [pk, increment]
  name          varchar   [not null]
  email         varchar   [not null, unique]
  password_hash varchar   [not null]
  is_moderator  boolean   [not null, default: false]
  created_at    timestamp [not null, default: `now()`]

  Note: 'A user with is_moderator = true acts as a Moderator. Any user (moderator or not) can act as a Member: host on their own properties, seeker on applications they submit.'
}

Table neighborhoods {
  id   int     [pk, increment]
  name varchar [not null, unique]
}

Table amenities {
  id   int     [pk, increment]
  name varchar [not null, unique]
}

Table properties {
  id              int       [pk, increment]
  host_id         int       [not null, ref: > users.id]
  neighborhood_id int       [not null, ref: > neighborhoods.id]
  address         varchar   [not null]
  description     text
  created_at      timestamp [not null, default: `now()`]
}

Table property_amenities {
  property_id int [ref: > properties.id]
  amenity_id  int [ref: > amenities.id]

  indexes {
    (property_id, amenity_id) [pk]
  }
}

Table rooms {
  id              int       [pk, increment]
  property_id     int       [not null, ref: > properties.id]
  label           varchar   [not null, note: 'e.g. "Room 2", "Attic room"']
  price           int       [not null]
  available_from  date      [not null]
  status          varchar   [not null, default: 'available', note: 'available | rented | inactive']
  description     text
  created_at      timestamp [not null, default: `now()`]
}

Table room_photos {
  id          int     [pk, increment]
  room_id     int     [not null, ref: > rooms.id]
  url         varchar [not null]
  sort_order  int     [not null, default: 0]
}

Table applications {
  id           int       [pk, increment]
  room_id      int       [not null, ref: > rooms.id]
  seeker_id    int       [not null, ref: > users.id]
  message      text      [not null]
  status       varchar   [not null, default: 'submitted', note: 'submitted | shortlisted | accepted | rejected | withdrawn']
  created_at   timestamp [not null, default: `now()`]
  updated_at   timestamp [not null, default: `now()`]

  indexes {
    (room_id, seeker_id) [unique]
  }
}

Table visits {
  id             int       [pk, increment]
  application_id int       [not null, ref: > applications.id]
  scheduled_at   timestamp [not null]
  status         varchar   [not null, default: 'scheduled', note: 'scheduled | completed | cancelled']
}

Table reviews {
  id          int       [pk, increment]
  property_id int       [not null, ref: > properties.id]
  author_id   int       [not null, ref: > users.id]
  rating      int       [not null, note: '1 to 5']
  comment     text
  created_at  timestamp [not null, default: `now()`]
}

Table saved_listings {
  seeker_id  int       [not null, ref: > users.id]
  room_id    int       [not null, ref: > rooms.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (seeker_id, room_id) [pk]
  }
}

Table reports {
  id           int       [pk, increment]
  room_id      int       [not null, ref: > rooms.id]
  reporter_id  int       [not null, ref: > users.id]
  reason       text      [not null]
  status       varchar   [not null, default: 'pending', note: 'pending | dismissed | actioned']
  resolved_by  int       [ref: > users.id, note: 'moderator (users.id) who resolved the report, null while pending']
  created_at   timestamp [not null, default: `now()`]
  resolved_at  timestamp
}
